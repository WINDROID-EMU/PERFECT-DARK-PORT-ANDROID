+		ENET_SOCKOPT_IPV6_V6ONLY = 10
+	} ENetSocketOption;
+
+	typedef enum _ENetSocketShutdown {
+		ENET_SOCKET_SHUTDOWN_READ       = 0,
+		ENET_SOCKET_SHUTDOWN_WRITE      = 1,
+		ENET_SOCKET_SHUTDOWN_READ_WRITE = 2
+	} ENetSocketShutdown;
+
+	typedef struct _ENetAddress {
+		union {
+			struct in6_addr ipv6;
+			struct {
+				uint8_t zeros[10];
+				uint16_t ffff;
+				struct in_addr ip;
+			} ipv4;
