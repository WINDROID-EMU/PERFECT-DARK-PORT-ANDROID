+	int enet_host_check_events(ENetHost* host, ENetEvent* event) {
+		if (event == NULL)
+			return -1;
+
+		event->type = ENET_EVENT_TYPE_NONE;
+		event->peer = NULL;
+		event->packet = NULL;
+
+		return enet_protocol_dispatch_incoming_commands(host, event);
+	}
