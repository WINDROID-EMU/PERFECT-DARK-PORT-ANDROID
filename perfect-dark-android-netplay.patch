+
+			enet_list_remove(&acknowledgement->acknowledgementList);
+			enet_free(acknowledgement);
+
+			++command;
+			++buffer;
+		}
+
+		host->commandCount = command - host->commands;
+		host->bufferCount = buffer - host->buffers;
+	}
