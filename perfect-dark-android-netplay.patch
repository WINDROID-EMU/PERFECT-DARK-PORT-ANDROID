+	} ENET_PACKED ENetProtocolSendUnsequenced;
+
+	typedef struct _ENetProtocolSendFragment {
+		ENetProtocolCommandHeader header;
+		uint16_t startSequenceNumber;
+		uint16_t dataLength;
+		uint32_t fragmentCount;
+		uint32_t fragmentNumber;
