+				switch (peer->state) {
+					case ENET_PEER_STATE_DISCONNECTING:
+					case ENET_PEER_STATE_ACKNOWLEDGING_CONNECT:
+					case ENET_PEER_STATE_DISCONNECTED:
+					case ENET_PEER_STATE_ZOMBIE:
